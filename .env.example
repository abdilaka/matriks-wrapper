# Matriks Web Trader wrapper — credentials & config (copy to .env, never commit .env)

# --- Ziraat login (initial auth; captcha + OTP done by human at login trigger) ---
ZRY_CUSTOMER_NO=          # Müşteri Numarası
ZRY_PASSWORD=            # Parola (login only; not the MQTT password)

# --- Endpoints (defaults; override if app version/issuer changes) ---
MTX_ISSUER=ZRTYAT
MTX_GATEWAY_URL=https://mobil.ziraatyatirim.com.tr/0379_webtrader_px/GetUrl.aspx
MTX_DISCO_URL=https://disco.matriksdata.com/disco-v2.json
MTX_ORIGIN=https://ziraatyatirim.matrikswebtrader.com
MTX_SOURCE_ID=70
MTX_APP_VERSION=5419

# --- MQTT ---
MTX_MQTT_USERNAME=JTW     # constant data-vendor account; identity is in the JWT

# --- Session material (populated by the login trigger at runtime; do NOT hand-edit) ---
# Stored in session_store.json (gitignored): SessionKey, sessionUsername, sessionPassword,
# HardwareID, ParentRef.

# --- Telegram relay (captcha image + OTP prompt during remote login) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Playwright ---
HEADLESS=1            # 0 to watch the browser while debugging locally
